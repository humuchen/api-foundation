{
	"compilerOptions": {
		// ESM（package.json "type": "module"）：NodeNext 要求相对导入显式 .js 扩展名
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"target": "ES2021",
		"sourceMap": true,
		"outDir": "./dist",
		"baseUrl": "./",
		"incremental": true,
		"skipLibCheck": true,
		"strict": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
