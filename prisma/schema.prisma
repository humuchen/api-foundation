// Prisma 数据层定义（SQLite：零外部依赖，生产可平滑切换 PostgreSQL/MySQL）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  nickname     String
  // SQLite 不支持标量数组：角色以 JSON 序列化存储（["admin","ops","user"]），
  // 仓储层负责与 roles: string[] 的映射；切换 PostgreSQL 后可改为 JSONB
  rolesJson    String   @default("[]")
  // 租户归属：null = 平台级账号（不受租户隔离约束）；隔离策略见 user.repository
  tenantId     String?
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@map("users")
}

// 审计持久化（替代内存环形缓冲）：who/when/what/入参摘要/结果/链路/租户。
// body 以 JSON 字符串存储（bodyJson），与 rolesJson 同风格——脱敏后的入参摘要。
model AuditLog {
  id            String   @id @default(uuid())
  requestId     String
  tenantId      String?
  action        String
  method        String
  path          String
  actorId       String?
  actorUsername String?
  bodyJson      String?
  success       Boolean
  durationMs    Int
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}
