// Prisma 数据层定义（SQLite：零外部依赖，生产可平滑切换 PostgreSQL/MySQL）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  nickname     String
  // SQLite 不支持标量数组：角色以 JSON 序列化存储（["admin","ops","user"]），
  // 仓储层负责与 roles: string[] 的映射；切换 PostgreSQL 后可改为 JSONB
  rolesJson    String   @default("[]")
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
