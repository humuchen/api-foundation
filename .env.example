# 复制为 .env 使用；所有项均有默认值，仅按需覆盖
NODE_ENV=development
PORT=3000
# 仅到 'api'：URI 版本化在其后追加 /v1 /v2
GLOBAL_PREFIX=api
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# JWT（生产环境必须显式设置强随机密钥，否则启动即失败）
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=2h

# 数据库（开发缺省回退 SQLite dev.db；生产必须显式配置，如 postgresql://...）
DATABASE_URL="file:./dev.db"
# PostgreSQL 本地实例（docker compose up -d 后启用）：
# DATABASE_URL="postgresql://api:api_password@localhost:5432/api_foundation"

# 缓存/幂等/凭证黑名单共享存储：memory（默认，零依赖）| redis（多实例部署必选）
CACHE_STORE=memory
# CACHE_STORE=redis 时必填；幂等与凭证黑名单随之外置，业务代码零改动
# REDIS_URL=redis://localhost:6379

# CORS 白名单（逗号分隔）；生产环境未配置时拒绝所有跨域
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
