  "info": {
    "title": "NestJS v12 通用接口底座",
    "description": "统一响应/错误码/参数校验/JWT 鉴权/RBAC/分页/审计/限流/幂等/缓存契约演示。全站默认需登录（@Public 白名单除外）：先调 POST /auth/login 获取凭证对，点右上角 Authorize 填入 accessToken。内置账号：admin/admin123（admin）、ops/ops123456（ops）、demo/demo123456（user）。URI 版本化：/api/v1/* 稳定契约，/api/v2/* 演示并行版本。⚠️ Execute 前请先在顶部 Servers 下拉选择目标环境：本页为静态文档站，需本地运行 pnpm run dev 并选择 localhost，否则请求会打到静态托管域名返回 404。",
    "version": "0.4.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "本地开发（pnpm run dev）"
    },
    {
      "url": "/",
      "description": "同源部署（API 与本文档同域名时可选）"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin",
            "description": "用户名"
          },
          "password": {
            "type": "string",
            "example": "admin123",
            "minLength": 6,
            "description": "密码"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "登录时签发的 refreshToken"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "可选：同时吊销该 refreshToken（登出全设备时传入）"
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "newuser",
            "description": "3-32 位字母/数字/下划线"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "密码（6-64 位）"
          },
          "nickname": {
            "type": "string",
            "description": "昵称，缺省取 username"
          },
          "roles": {
            "type": "string",
            "enum": [
              "admin",
              "ops",
              "user"
            ],
            "example": [
              "user"
            ]
          }
        },
        "required": [
          "username",
          "password",
          "roles"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string"
          },
          "roles": {
            "type": "string",
            "enum": [
              "admin",
              "ops",
              "user"
            ]
          }
        }
      },
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "ecommerce-manager",
            "description": "角色编码（唯一，创建后不可改）"
          },
          "name": {
            "type": "string",
            "example": "电商运营",
            "description": "角色名称"
          },
          "description": {
            "type": "string",
            "description": "角色描述"
          },
          "sort": {
            "type": "number",
            "default": 0,
            "description": "排序权重（小者在前）"
          },
          "disabled": {
            "type": "boolean",
            "default": false,
            "description": "是否禁用（禁用后其授权不再生效）"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "角色名称"
          },
          "description": {
            "type": "string",
            "description": "角色描述"
          },
          "sort": {
            "type": "number",
            "description": "排序权重"
          },
          "disabled": {
            "type": "boolean",
            "description": "是否禁用"
          }
        }
      },
      "CreatePermissionDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "order:refund:approve",
            "description": "权限编码（唯一，创建后不可改）"
          },
          "name": {
            "type": "string",
            "example": "订单退款审批",
            "description": "权限名称"
          },
          "resource": {
            "type": "string",
            "example": "refund",
            "description": "资源域（权限分组展示用）"
          },
          "action": {
            "type": "string",
            "example": "approve",
            "description": "动作标识"
          },
          "type": {
            "type": "string",
            "enum": [
              "api",
              "menu",
              "button"
            ],
            "default": "api",
            "description": "权限类型"
          },
          "description": {
            "type": "string",
            "description": "权限描述"
          },
          "sort": {
            "type": "number",
            "default": 0,
            "description": "排序权重"
          }
        },
        "required": [
          "code",
          "name",
          "resource",
          "action"
        ]
      },
      "GrantPermissionsDto": {
        "type": "object",
        "properties": {
          "permissionCodes": {
            "example": [
              "admin:role:list",
              "demo:product:create"
            ],
            "description": "授权权限码全集（全量替换；空数组 = 收回全部授权）",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "permissionCodes"
        ]
      },
      "BindUserRolesDto": {
        "type": "object",
        "properties": {
          "roleCodes": {
            "example": [
              "ops"
            ],
            "description": "绑定角色编码全集（全量替换；空数组 = 解绑全部）",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "roleCodes"
        ]
      },
      "CreateMenuDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "format": "uuid",
            "description": "父级菜单 ID（缺省 = 顶级）"
          },
          "name": {
            "type": "string",
            "example": "角色管理",
            "description": "菜单名称"
          },
          "path": {
            "type": "string",
            "example": "/system/roles",
            "description": "路由路径（站内唯一，/ 开头）"
          },
          "component": {
            "type": "string",
            "example": "admin/RoleList",
            "description": "前端组件标识（渲染器按此懒加载页面）"
          },
          "icon": {
            "type": "string",
            "description": "图标标识"
          },
          "sort": {
            "type": "number",
            "default": 0,
            "description": "排序权重（小者在前）"
          },
          "type": {
            "type": "string",
            "enum": [
              "directory",
              "menu"
            ],
            "default": "menu",
            "description": "菜单类型"
          },
          "permCode": {
            "type": "string",
            "example": "admin:role:list",
            "description": "可见性权限码（缺省 = 登录即可见；置值则需权限集合包含）"
          },
          "visible": {
            "type": "boolean",
            "default": true,
            "description": "是否在导航中显示"
          },
          "meta": {
            "type": "object",
            "example": {
              "title": "角色管理",
              "keepAlive": true,
              "layout": "sidebar"
            },
            "description": "路由元信息（title/keepAlive/layout/theme 等，原样下发前端生成动态路由）"
          }
        },
        "required": [
          "name",
          "path"
        ]
      },
      "UpdateMenuDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "description": "父级菜单 ID"
          },
          "name": {
