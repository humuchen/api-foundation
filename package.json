{
  "name": "api-foundation",
  "version": "1.0.0",
  "description": "NestJS v12 通用后端接口底座（统一响应/鉴权/审计/幂等/分页/缓存）",
  "main": "dist/main.js",
  "scripts": {
    "start": "ts-node src/main.ts",
    "dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "prod": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "openapi:export": "ts-node scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "12.3.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "12.3.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "12.3.0",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "ms": "^2.1.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
